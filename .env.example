APP_NAME=SCM DEMO
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# FastAPI runtime account. It should NOT own tables and should NOT have BYPASSRLS.
DATABASE_URL=postgresql+asyncpg://app_runtime:local_dev_password@localhost:5432/scm_local

# Alembic/schema owner. Do not use this account as the FastAPI runtime account.
MIGRATION_DATABASE_URL=postgresql+asyncpg://scm_owner:local_owner_password@localhost:5432/scm_local

# Local mode uses X-Dev-User-Id for easy Swagger testing.
# Production mode should use a real JWT provider (Supabase Auth or another IdP).
AUTH_MODE=dev_header
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=authenticated
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Production: json / INFO. Local development can use console / DEBUG.
LOG_LEVEL=INFO
LOG_FORMAT=console
SLOW_REQUEST_THRESHOLD_MS=1000
SQLALCHEMY_ECHO=false

# Private attachment storage. Credentials use the standard AWS SDK provider chain.
AWS_REGION=ap-northeast-1
S3_ATTACHMENTS_BUCKET=scm-demo-dev-attachments-xxx
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ATTACHMENT_DOWNLOAD_URL_EXPIRE_SECONDS=300
